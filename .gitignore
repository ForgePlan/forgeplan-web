node_modules/
.DS_Store

# template build artefacts (must never live inside template/ — see rule 21)
template/node_modules/
template/.svelte-kit/
template/build/
template/dist/

# pre-built artifacts published to npm — regenerated by `npm run build`
# (one dist*/ per declared image in config/images.json — PRD-030 / RFC-026 / ADR-005)
dist/
dist-*/
.dist-base/

# scratch dev runs of `init` against this repo
.forgeplan-web/

# Forgeplan-derived index (regenerated by `forgeplan scan-import`)
.forgeplan/lance/
.forgeplan/.lock
.forgeplan/.lance.backup-*/
.forgeplan/.fastembed_cache/
.forgeplan/logs/
.forgeplan/trash/
.forgeplan/state/
.forgeplan/claims/
.forgeplan/journal/
.forgeplan/session.yaml
.forgeplan/anomalies-journal.jsonl
.forgeplan/map/.work/

# local-only scratch (never shared)
.local/

# editor / OS
*.log
.idea/
.vscode/

# MCP playwright artefacts (transient page snapshots)
.playwright-mcp/

# Playwright test screenshots (L4 verification, not for commit)
f[0-9]-*.png
