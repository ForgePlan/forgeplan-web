{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(forgeplan:*)",
      "Bash(rtk forgeplan:*)",
      "Bash(rtk read *)",
      "Bash(rtk find *)",
      "Bash(rtk ls *)",
      "Bash(rtk grep *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",
      "Bash(chmod +x .claude/hooks/*.sh)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard origin/*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -D master*)",
      "Bash(rm -rf /*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(cargo publish*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash $(git rev-parse --show-toplevel)/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $(git rev-parse --show-toplevel)/.claude/hooks/user-prompt-rules-nudge.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $(git rev-parse --show-toplevel)/.claude/hooks/forge-safety-hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $(git rev-parse --show-toplevel)/.claude/hooks/post-edit-format.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "forgeplan-workflow@ForgePlan-marketplace": true,
    "fpl-skills@ForgePlan-marketplace": true,
    "fpf@ForgePlan-marketplace": true,
    "laws-of-ux@ForgePlan-marketplace": true,
    "forgeplan-orchestra@ForgePlan-marketplace": true,
    "forgeplan-brownfield-pack@ForgePlan-marketplace": true,
    "agents-core@ForgePlan-marketplace": true,
    "agents-domain@ForgePlan-marketplace": true,
    "agents-github@ForgePlan-marketplace": true,
    "agents-pro@ForgePlan-marketplace": true,
    "agents-sparc@ForgePlan-marketplace": true
  },
  "project": {
    "name": "forgeplan-web",
    "description": "Interactive realtime web map for a Forgeplan workspace",
    "language": "typescript",
    "framework": "sveltekit"
  },
  "agents": {
    "enabled": true,
    "directory": ".claude/agents"
  },
  "skills": {
    "directory": ".claude/skills"
  },
  "rules": {
    "directory": ".claude/rules"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
